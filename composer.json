{
    "name": "teoprayoga/laravel-teorion",
    "description": "Request-driven query filter package for Laravel — formalized ScopeFilterTrait pattern with whitelist, isolated scope params, and single-call ViewModel support.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Teo Prayoga",
            "email": "teo@undiksha.ac.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Teoprayoga\\Teorion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Teoprayoga\\Teorion\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Teoprayoga\\Teorion\\TeorionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
